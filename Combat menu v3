local tpBall, tpBill, tpESP = nil, nil, nil
local tpLabel, npcDistLabel = nil, nil

local TPCFG = {
    COOLDOWN  = 0.25,
    MAX_DIST  = 80,
    AIM_ANGLE = 35,
    NPC_DIST  = 5,
    TP_MIN    = 3,
    TP_MAX    = 3.8,
    SCAN_EVERY = 0.12,
}
local lastScan = 0

local function getRoot(c) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHead(c) return c and c:FindFirstChild("Head") end

local function angleFromView(c, pos)
    local h = getHead(c)
    if not h then return 180 end
    local dot = h.CFrame.LookVector:Dot((pos - h.Position).Unit)
    return math.deg(math.acos(math.clamp(dot, -1, 1)))
end

local function isAimingAtMe(c, myRoot)
    if not c:FindFirstChildOfClass("Tool") then return false end
    return angleFromView(c, myRoot.Position) <= TPCFG.AIM_ANGLE
end

local function tpUnmark()
