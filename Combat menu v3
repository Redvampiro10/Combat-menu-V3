                    Vector3.new(np.X-(half+sR)/2, np.Y+1, np.Z),
                }
                for _, vp in pairs(voidParts) do
                    if vp.Name == "VoidKill" then
                        vp.Position = ns[i] or vp.Position
                        i = i + 1
                    end
                end
            end
        end
    end)
    notif("☠️ Void Zone ATIVA!", 4)
end

