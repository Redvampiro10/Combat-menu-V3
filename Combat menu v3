-- TP V17.1: PivotTo + escolhe o lado que MAIS AUMENTA distância da ameaça
local function doTP(threatChar, threatRoot)
    local myChar = lp.Character
    local myRoot = getRoot(myChar)
    if not myChar or not myRoot then return end

    local d = math.random(TPCFG.TP_MIN*100, TPCFG.TP_MAX*100)/100
    local sideV = threatRoot.CFrame.RightVector

    local posR = myRoot.Position + sideV * d
    local posL = myRoot.Position - sideV * d
    posR = Vector3.new(posR.X, myRoot.Position.Y, posR.Z)
    posL = Vector3.new(posL.X, myRoot.Position.Y, posL.Z)

    -- pontua cada lado: queremos FORA da visão E mais longe da ameaça
    local myPos = myRoot.Position
    local distNow = (myPos - threatRoot.Position).Magnitude

    local distR = (posR - threatRoot.Position).Magnitude
    local distL = (posL - threatRoot.Position).Magnitude
    local angR  = angleFromView(threatChar, posR)
    local angL  = angleFromView(threatChar, posL)

    -- lado válido = aumenta distância. Entre os válidos, pega o de maior ângulo (fora da mira)
    local validR = distR > distNow
    local validL = distL > distNow

    local chosen
    if validR and validL then
        chosen = (angR >= angL) and posR or posL
    elseif validR then
        chosen = posR
    elseif validL then
        chosen = posL
    else
        -- nenhum lado aumentou (ameaça colada) → recua pra trás dela
        local back = (myPos - threatRoot.Position).Unit * (d + 1)
        chosen = Vector3.new(myPos.X + back.X, myPos.Y, myPos.Z + back.Z)
    end

    -- fallback: ainda dentro da mira → puxa pra trás da ameaça
    if angleFromView(threatChar, chosen) < TPCFG.AIM_ANGLE then
        local b = chosen - threatRoot.CFrame.LookVector * 1.5
        chosen = Vector3.new(b.X, myRoot.Position.Y, b.Z)
    end

    -- PivotTo = teleporte mais estável no mobile (não briga com animação/physics)
    pcall(function()
        myChar:PivotTo(CFrame.new(chosen) * (myRoot.CFrame - myRoot.CFrame.Position))
    end)
end

RunService.Heartbeat:Connect(function()
    if tpBall and markedPlr and markedPlr.Character then
        local h = getHead(markedPlr.Character)
        if h then tpBall.Position = h.Position + Vector3.new(0,1.4,0) end
    elseif tpBall and (not markedPlr or not markedPlr.Character) then
        tpUnmark()
    end

    if (not tpMiraOn and not tpNPCOn) then return end
    if tick() - lastTP < TPCFG.COOLDOWN then return end
    if tick() - lastScan < TPCFG.SCAN_EVERY then return end
    lastScan = tick()

    local myChar = lp.Character
    local myRoot = getRoot(myChar)
    if not myRoot then return end

    -- ── ANTI-MIRA ──
    if tpMiraOn then
        if markedPlr and markedPlr.Character then
            local mr = getRoot(markedPlr.Character)
            if mr then
                local dist = (mr.Position - myRoot.Position).Magnitude
                if dist <= TPCFG.MAX_DIST and isAimingAtMe(markedPlr.Character, myRoot) then
                    doTP(markedPlr.Character, mr)
                    lastTP = tick()
                    notif("🌀 TP! "..markedPlr.Name.." mirou em você", 1.5)
                    return
                end
            end
        end
        local best, bestDist = nil, math.huge
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= lp and p.Character then
                local pr = getRoot(p.Character)
                if pr then
                    local dist = (pr.Position - myRoot.Position).Magnitude
                    if dist <= TPCFG.MAX_DIST and dist < bestDist and isAimingAtMe(p.Character, myRoot) then
                        best = p; bestDist = dist
                    end
                end
            end
        end
        if best then
            doTP(best.Character, getRoot(best.Character))
            lastTP = tick()
            notif("🌀 TP! "..best.Name.." mirou em você", 1.5)
            return
        end
    end

    -- ── ANTI-NPC: scan completo (GetDescendants = acha NPC em qualquer pasta) ──
    if tpNPCOn then
        local pChars = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then pChars[p.Character] = true end
        end
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and not pChars[obj] and obj ~= myChar then
                local h = obj:FindFirstChildOfClass("Humanoid")
                if h and h.Health > 0 and h.MaxHealth < 1000000 then
                    local r = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                    if r and (r.Position - myRoot.Position).Magnitude <= TPCFG.NPC_DIST then
                        doTP(obj, r)
                        lastTP = tick()
                        notif("🌀 TP! NPC chegou a "..TPCFG.NPC_DIST.."m", 1.2)
                        return
                    end
                end
            end
        end
    end
end)

local function tryMarkFromScreen(pos)
    local ray = cam:ViewportPointToRay(pos.X, pos.Y)
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { lp.Character, tpBall }
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(ray.Origin, ray.Direction * 400, params)
    if not result then return end
    local model = result.Instance:FindFirstAncestorOfClass("Model")
    if not model then return end
    local plr = Players:GetPlayerFromCharacter(model)
    if plr and plr ~= lp then tpMark(plr, "tiro") end
end

local function hookDano(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end
    hum.HealthChanged:Connect(function(nv)
        if nv < hum.MaxHealth and nv > 0 then
            local myRoot = getRoot(char)
            if not myRoot then return end
            local sus, susD = nil, math.huge
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= lp and p.Character then
                    local pr = getRoot(p.Character)
                    if pr then
                        local d = (pr.Position - myRoot.Position).Magnitude
                        if d <= 150 and d < susD and angleFromView(p.Character, myRoot.Position) <= TPCFG.AIM_ANGLE then
                            sus = p; susD = d
                        end
                    end
                end
            end
            if sus then tpMark(sus, "atirou em você") end
        end
    end)
end
if lp.Character then hookDano(lp.Character) end
lp.CharacterAdded:Connect(hookDano)
Players.PlayerRemoving:Connect(function(p)
    if markedPlr == p then tpUnmark() end
end)

UserInputService.TouchStarted:Connect(function(touch, gpe)
    if gpe then return end
    if touch.Position.X > cam.ViewportSize.X * 0.5 then
        tryMarkFromScreen(touch.Position)
        if atkOn then atkAll() end
        if npcOn then atkNPCs() end
        if stealOn then stealAll() end
    end
end)

-- ============================================================
-- GOD MODE
-- ============================================================
local GOD_HP = 1000000
local function stopGod()
    godOn = false
    if godConn then pcall(function() godConn:Disconnect() end); godConn = nil end
    pcall(function()
        local char = lp.Character
        if not char then return end
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then
            h.BreakJointsOnDeath = true
            h:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
            h.MaxHealth = 100; h.Health = 100
        end
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("ForceField") then v:Destroy() end
        end
    end)
end

local function setupChar(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    pcall(function()
        hum.BreakJointsOnDeath = false
        hum.MaxHealth = GOD_HP; hum.Health = GOD_HP
        if not char:FindFirstChildOfClass("ForceField") then
            local ff = Instance.new("ForceField")
            ff.Visible = false; ff.Parent = char
        end
    end)
end

local function startGod()
    local char = lp.Character
    setupChar(char)
    godConn = RunService.Heartbeat:Connect(function()
        if not godOn then return end
        local c = lp.Character
        if not c then return end
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        pcall(function() hum.BreakJointsOnDeath = false; hum.Health = GOD_HP end)
    end)
    local function conectarMorte(c)
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        hum.StateChanged:Connect(function(_, new)
            if not godOn then return end
            if new == Enum.HumanoidStateType.Dead then
                task.defer(function() pcall(function()
                    hum.Health = GOD_HP
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end) end)
            end
        end)
    end
    conectarMorte(char)
    task.spawn(function()
        while godOn do
            task.wait(0.5)
            if not godOn then break end
            local myChar = lp.Character
            local pChars = {}
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character then pChars[p.Character] = true end
            end
            for _, obj in pairs(workspace:GetDescendants()) do
                if not godOn then break end
                if obj:IsA("Model") and not pChars[obj] and obj ~= myChar then
                    local eh = obj:FindFirstChildOfClass("Humanoid")
                    if eh and eh.Health > 0 and eh.MaxHealth < 500000 then
                        task.spawn(function() kill(obj) end)
                    end
                end
            end
        end
    end)
    lp.CharacterAdded:Connect(function(nc)
        if not godOn then return end
        task.wait(0.15)
        setupChar(nc)
        conectarMorte(nc)
        if godConn then godConn:Disconnect() end
        startGod()
    end)
end

