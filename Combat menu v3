    if tpBill then tpBill:Destroy() tpBill = nil end
    if tpESP  then tpESP:Destroy()  tpESP = nil end
    markedPlr = nil
    if tpLabel then
        tpLabel.Text = "🎯 Alvo: nenhum"
        tpLabel.TextColor3 = Color3.fromRGB(135,135,155)
    end
end

